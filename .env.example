# Compose
COMPOSE_PROJECT_NAME=brega-chai
NODE_ENV=development
SEED_ALLOWED=false

# PostgreSQL
POSTGRES_DB=brega_chai
POSTGRES_USER=brega_chai
POSTGRES_PASSWORD=
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=brega_chai
DATABASE_USERNAME=brega_chai
DATABASE_PASSWORD=
DATABASE_SSL=false

# Strapi
HOST=0.0.0.0
PORT=1337
STRAPI_URL=http://localhost:1337
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Email notifications (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Brega Tea <no-reply@example.test>
SMTP_REPLY_TO=Brega Tea <no-reply@example.test>
SMTP_CONNECTION_TIMEOUT_MS=5000

# Storefront
SITE_URL=http://localhost:3000
CMS_INTERNAL_URL=http://cms:1337
NEXT_PUBLIC_CMS_URL=http://localhost:1337
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000
CHECKOUT_FORM_SECRET=
STRAPI_ORDER_TOKEN=

# Cache revalidation (shared secret must be identical in web and CMS)
CACHE_REVALIDATION_URL=http://web:3000/api/revalidate
CACHE_REVALIDATION_SECRET=
CACHE_REVALIDATION_TIMEOUT_MS=3000

# RustFS
# Required: set a tested, immutable image reference (tag or digest).
RUSTFS_IMAGE=rustfs/rustfs:1.0.0-beta.11
# Required: tested immutable image containing the `mc` S3 client.
S3_CLIENT_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z-cpuv1
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
RUSTFS_BUCKET=storefront
UPLOAD_PROVIDER=aws-s3
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=storefront
S3_ACCESS_KEY_ID=
S3_ACCESS_SECRET=
MEDIA_PUBLIC_URL=http://localhost:9000/storefront

# Production routing
APP_DOMAIN=brega.example
ADMIN_DOMAIN=admin.brega.example
MEDIA_DOMAIN=media.brega.example
TLS_EMAIL=

# Backup
BACKUP_ROOT=./backups
BACKUP_KEEP=1

# Production deploy (GitLab protected variables override these)
WEB_IMAGE=
CMS_IMAGE=
SMOKE_URL=
