limit_req_zone $binary_remote_addr zone=orders:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=admin_login:10m rate=10r/m;

map $http_upgrade $connection_upgrade {
  default upgrade;
  "" close;
}

upstream storefront {
  server web:3000;
}

upstream strapi {
  server cms:1337;
}

upstream media {
  server rustfs:9000;
}

server {
  listen 80;
  server_name ${APP_DOMAIN} ${ADMIN_DOMAIN} ${MEDIA_DOMAIN};

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${APP_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
  include /etc/nginx/security_headers.conf;
  # Static and ISR-rendered Next.js pages require inline bootstrap and RSC scripts.
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://${MEDIA_DOMAIN}; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
  add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

  location = /robots.txt {
    default_type text/plain;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    return 200 "User-agent: *\nDisallow: /\n";
  }

  location = /api/checkout/orders {
    limit_req zone=orders burst=3 nodelay;
    proxy_pass http://storefront;
    include /etc/nginx/proxy_params;
  }

  location ^~ /legal/ {
    include /etc/nginx/security_headers.conf;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    proxy_pass http://storefront;
    include /etc/nginx/proxy_params;
  }

  location / {
    proxy_pass http://storefront;
    include /etc/nginx/proxy_params;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${ADMIN_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
  include /etc/nginx/security_headers.conf;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://${MEDIA_DOMAIN}; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https://${MEDIA_DOMAIN}; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
  client_max_body_size 12m;

  location ~ ^/admin/(login|forgot-password) {
    limit_req zone=admin_login burst=5 nodelay;
    proxy_pass http://strapi;
    include /etc/nginx/proxy_params;
  }

  location / {
    proxy_pass http://strapi;
    include /etc/nginx/proxy_params;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${MEDIA_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;
  include /etc/nginx/security_headers.conf;
  add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;

  location / {
    limit_except GET HEAD {
      deny all;
    }

    proxy_pass http://media/${RUSTFS_BUCKET}/;
    include /etc/nginx/proxy_params;
  }
}
