{
  "name": "brega-chai",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "format": "prettier --write \"apps/**/*.{ts,tsx,mts,mjs,json,css}\" \"packages/**/*.{ts,json}\" \"*.{json,yml,yaml}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,mts,mjs,json,css}\" \"packages/**/*.{ts,json}\" \"*.{json,yml,yaml}\"",
    "lint": "turbo lint",
    "seed": "yarn workspace @brega-chai/cms seed",
    "test": "turbo test",
    "test:e2e": "yarn workspace @brega-chai/web test:e2e",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.8",
    "typescript": "5.9.2"
  }
}
