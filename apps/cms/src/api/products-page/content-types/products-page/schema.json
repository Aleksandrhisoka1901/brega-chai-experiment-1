{
  "kind": "singleType",
  "collectionName": "products_pages",
  "info": {
    "singularName": "products-page",
    "pluralName": "products-pages",
    "displayName": "Products page"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    },
    "title": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "intro": {
      "type": "blocks",
      "required": true,
      "description": "Keep the introduction concise, using short paragraphs and only the headings, lists, links, or images that help readers scan it. An H1 entered here is rendered as H2 by the storefront. Unsupported or executable content, including scripts, is not rendered."
    },
    "image": {
      "type": "component",
      "component": "shared.image-with-alt",
      "repeatable": false,
      "required": false
    }
  }
}
