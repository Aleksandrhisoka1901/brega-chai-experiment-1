<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light only" />
    <title>{{title}} — Voltora</title>
    <style>
      @media only screen and (max-width: 640px) {
        .email-shell {
          width: 100% !important;
        }
        .email-pad {
          padding-left: 24px !important;
          padding-right: 24px !important;
        }
        .email-title {
          font-size: 32px !important;
          line-height: 36px !important;
        }
        .detail-label {
          width: 38% !important;
        }
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background: #eef1f4; color: #1e2329;">
    <div
      style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent;"
    >{{preheader}}&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      bgcolor="#eef1f4"
      style="width: 100%; background: #eef1f4;"
    >
      <tr>
        <td align="center" style="padding: 32px 12px;">
          <table
            class="email-shell"
            role="presentation"
            width="640"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="width: 640px; max-width: 640px; border: 1px solid #d5dbe3; background: #ffffff;"
          >
            <tr>
              <td
                class="email-pad"
                bgcolor="#1e2329"
                style="padding: 22px 42px; background: #1e2329;"
              >
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                >
                  <tr>
                    <td
                      style="color: #f5f7fa; font-family: Arial, Helvetica, sans-serif; font-size: 22px; letter-spacing: -0.02em; line-height: 26px;"
                    ><a
                        href="{{siteUrl}}"
                        style="color: #ffffff; text-decoration: none;"
                      >Voltora</a></td>
                    <td
                      align="right"
                      style="color: #a8b0b8; font-family: Arial, Helvetica, sans-serif; font-size: 10px; line-height: 16px; letter-spacing: 0.16em; text-transform: uppercase;"
                    >{{eyebrow}}</td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td bgcolor="#ff8a00" style="height: 3px; line-height: 3px; font-size: 0; background: #ff8a00;">&nbsp;</td>
            </tr>
            <tr>
              <td
                class="email-pad"
                bgcolor="#1e2329"
                style="padding: 40px 42px 36px; background: #1e2329;"
              >
                <div
                  style="margin-bottom: 14px; color: #a8b0b8; font-family: Arial, Helvetica, sans-serif; font-size: 11px; line-height: 16px; letter-spacing: 0.14em; text-transform: uppercase;"
                >Заказ №{{orderNumber}}</div>
                <h1
                  class="email-title"
                  style="margin: 0; color: #f5f7fa; font-family: Arial, Helvetica, sans-serif; font-size: 36px; font-weight: 400; letter-spacing: -0.03em; line-height: 1.12;"
                >{{title}}</h1>
                <p
                  style="max-width: 500px; margin: 18px 0 0; color: #f5f7fa; font-family: Arial, Helvetica, sans-serif; font-size: 15px; line-height: 24px;"
                >{{lead}}</p>
              </td>
            </tr>
            <tr>
              <td class="email-pad" style="padding: 38px 42px 8px; background: #ffffff;">
                <div
                  style="margin-bottom: 14px; color: #7a8490; font-family: Arial, Helvetica, sans-serif; font-size: 10px; line-height: 16px; letter-spacing: 0.16em; text-transform: uppercase;"
                >Получение</div>
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                >
                  {{#each details}}
                    <tr>
                      <td
                        class="detail-label"
                        style="width: 34%; padding: 10px 12px 10px 0; border-bottom: 1px solid #d5dbe3; color: #7a8490; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 18px; letter-spacing: 0.08em; text-transform: uppercase; vertical-align: top;"
                      >{{label}}</td>
                      <td
                        style="padding: 10px 0 10px 12px; border-bottom: 1px solid #d5dbe3; color: #1e2329; font-family: Arial, Helvetica, sans-serif; font-size: 15px; line-height: 22px; vertical-align: top;"
                      >{{value}}</td>
                    </tr>
                  {{/each}}
                </table>
              </td>
            </tr>
            {{#if comment}}
              <tr>
                <td class="email-pad" style="padding: 26px 42px 4px; background: #ffffff;">
                  <table
                    role="presentation"
                    width="100%"
                    cellspacing="0"
                    cellpadding="0"
                    border="0"
                    bgcolor="#eef1f4"
                    style="background: #eef1f4;"
                  >
                    <tr>
                      <td
                        style="padding: 18px 20px; border-left: 3px solid #ff8a00;"
                      >
                        <div
                          style="margin-bottom: 6px; color: #7a8490; font-family: Arial, Helvetica, sans-serif; font-size: 10px; line-height: 15px; letter-spacing: 0.12em; text-transform: uppercase;"
                        >{{commentLabel}}</div>
                        <div
                          style="color: #1e2329; font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px;"
                        >{{comment}}</div>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            {{/if}}
            <tr>
              <td class="email-pad" style="padding: 34px 42px 0; background: #ffffff;">
                <div
                  style="margin-bottom: 8px; color: #7a8490; font-family: Arial, Helvetica, sans-serif; font-size: 10px; line-height: 16px; letter-spacing: 0.16em; text-transform: uppercase;"
                >Состав заказа</div>
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                >
                  {{#each lines}}
                    <tr>
                      <td
                        style="padding: 16px 8px 16px 0; border-bottom: 1px solid #d5dbe3; vertical-align: top;"
                      >
                        <div
                          style="color: #1e2329; font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 600; line-height: 22px;"
                        >{{title}}</div>
                        <div
                          style="padding-top: 4px; color: #5c6570; font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 17px;"
                        >{{packageLabel}}</div>
                      </td>
                      <td
                        style="width: 22%; padding: 16px 8px; border-bottom: 1px solid #d5dbe3; color: #5c6570; font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 20px; text-align: right; vertical-align: top; white-space: nowrap;"
                      >{{quantity}} × {{unitPrice}}</td>
                      <td
                        style="width: 22%; padding: 16px 0 16px 8px; border-bottom: 1px solid #d5dbe3; color: #1e2329; font-family: Arial, Helvetica, sans-serif; font-size: 14px; font-weight: 700; line-height: 20px; text-align: right; vertical-align: top; white-space: nowrap;"
                      >{{lineTotal}}</td>
                    </tr>
                  {{/each}}
                </table>
              </td>
            </tr>
            <tr>
              <td class="email-pad" style="padding: 28px 42px 32px; background: #ffffff;">
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                >
                  {{#if hasDiscount}}
                    <tr>
                      <td
                        style="padding: 4px 20px 4px 0; color: #5c6570; font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 20px;"
                      >Стандартная сумма</td>
                      <td
                        style="padding: 4px 0; color: #1e2329; font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 20px; text-align: right; white-space: nowrap;"
                      >{{standardTotal}}</td>
                    </tr>
                    <tr>
                      <td
                        style="padding: 4px 20px 12px 0; color: #5c6570; font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 20px;"
                      >Скидка за самовывоз</td>
                      <td
                        style="padding: 4px 0 12px; color: #1e2329; font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 20px; text-align: right; white-space: nowrap;"
                      >− {{discountPercent}}%</td>
                    </tr>
                  {{/if}}
                  <tr>
                    <td
                      style="padding: 15px 20px 15px 0; border-top: 1px solid #1e2329; color: #1e2329; font-family: Arial, Helvetica, sans-serif; font-size: 18px; font-weight: 600; line-height: 26px;"
                    >{{totalLabel}}</td>
                    <td
                      style="padding: 15px 0; border-top: 1px solid #1e2329; color: #1e2329; font-family: Arial, Helvetica, sans-serif; font-size: 22px; font-weight: 700; line-height: 28px; text-align: right; white-space: nowrap;"
                    >{{finalTotal}}</td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td
                class="email-pad"
                bgcolor="#1e2329"
                style="padding: 26px 42px; background: #1e2329; color: #f5f7fa;"
              >
                <div
                  style="color: #a8b0b8; font-family: Arial, Helvetica, sans-serif; font-size: 10px; line-height: 15px; letter-spacing: 0.12em; text-transform: uppercase;"
                >Портативные электростанции ·
                  <a
                    href="{{siteUrl}}"
                    style="color: #f5f7fa; text-decoration: none;"
                  >Voltora</a></div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
