{
  "kind": "singleType",
  "collectionName": "global_settings",
  "info": {
    "singularName": "global-setting",
    "pluralName": "global-settings",
    "displayName": "Global settings",
    "description": "Storefront-wide content and defaults"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "brandName": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "email": {
      "type": "email",
      "required": true
    },
    "telegramUrl": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 2048
    },
    "defaultProductStory": {
      "type": "blocks",
      "required": true,
      "description": "Recommended structure: a concise opening followed by short, clearly headed sections, paragraphs, lists, links, or images as useful. An H1 entered here is rendered as H2 by the storefront. Unsupported or executable content, including scripts, is not rendered."
    },
    "navigation": {
      "type": "component",
      "component": "shared.navigation-labels",
      "repeatable": false,
      "required": true
    },
    "currency": {
      "type": "enumeration",
      "enum": ["RUB"],
      "required": true,
      "default": "RUB"
    },
    "defaultSeo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": true
    },
    "legalDetails": {
      "type": "text",
      "required": true,
      "minLength": 1
    }
  }
}
