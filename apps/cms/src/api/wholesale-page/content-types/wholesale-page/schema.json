{
  "kind": "singleType",
  "collectionName": "wholesale_pages",
  "info": {
    "singularName": "wholesale-page",
    "pluralName": "wholesale-pages",
    "displayName": "Страница для оптовиков",
    "description": "Редакторская страница «Для оптовиков» с теми же блоками, что у статей"
