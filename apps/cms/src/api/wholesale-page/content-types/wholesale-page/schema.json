    "content": {
      "type": "richtext",
      "required": false,
      "description": "Основной текст над сеткой карточек. На витрине выводится только безопасный HTML."
    },
    "blocks": {
      "type": "dynamiczone",
      "components": ["article.cards-grid", "material-templates.cards-grid"],
      "required": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false,
      "required": false
    }
  }
}
