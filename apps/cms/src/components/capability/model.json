{
  "collectionName": "components_capability_models",
  "info": {
    "displayName": "Модель системы хранения",
    "description": "Карточка в ленте: фото, название и короткое описание."
  },
  "attributes": {
    "slug": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "description": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "productModel": {
      "type": "string",
      "required": false
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
