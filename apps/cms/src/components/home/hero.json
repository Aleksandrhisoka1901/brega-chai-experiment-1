{
  "collectionName": "components_home_heroes",
  "info": {
    "displayName": "Hero",
    "description": "Image and alt are required unless layout is 100/0"
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 1
    },
    "text": {
      "type": "text",
      "required": true,
      "minLength": 1
    },
    "layout": {
      "type": "enumeration",
      "enum": ["50/50", "40/60", "100/0"],
      "required": true,
      "default": "50/50"
    },
    "image": {
      "type": "component",
      "component": "shared.image-with-alt",
      "repeatable": false,
      "required": false
    },
    "backgroundColor": {
      "type": "string",
      "customField": "plugin::color-picker.color",
      "required": false
    },
    "textColor": {
      "type": "string",
      "customField": "plugin::color-picker.color",
      "required": false
    },
    "cta": {
      "type": "component",
      "component": "shared.link",
      "repeatable": false,
      "required": false
    }
  }
}
